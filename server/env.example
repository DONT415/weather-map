# Sao chép file này thành ".env" (cùng thư mục) rồi điền giá trị thật vào.
# File ".env" KHÔNG được commit lên git / chia sẻ công khai.

# Lấy API key MIỄN PHÍ tại https://aistudio.google.com/apikey
# (đăng nhập bằng tài khoản Google, bấm "Create API key" - không cần thẻ ngân hàng)
GEMINI_API_KEY=

# Model dùng cho Agent - gemini-3.6-flash nằm trong danh sách model
# miễn phí của Google AI Studio (đủ nhanh, đủ tốt cho hỏi đáp/viết nhận xét).
# Nếu muốn đổi model, xem danh sách free hiện tại tại aistudio.google.com.
GEMINI_MODEL=gemini-3.6-flash

# Cổng chạy backend (phải khớp với AGENT_API_BASE trong agent/weather-agent.js)
PORT=5501
